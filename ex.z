//ejercicio 1//
//definion de los operadores logicos//
Z=>Z not:= fn(Z p)->if(p,0,1);
Z=>Z=>Z or:= fn(Z p)-> fn(Z q)-> if(p,q,0);
Z=>Z=>Z and:= fn(Z p)-> fn(Z q)-> if(p,q,1);
Z=>Z=>Z eq:= fn(Z p)-> fn(Z q)-> or(and(p)(q))(and(not(p))(not(q)));

Z=>Z=>Z de_morgan1 := fn(Z p)-> fn(Z q)-> eq(not(and(p)(q)))(or(not(p))(not(q)));

Z=>Z=>Z de_morgan2 := fn(Z p)-> fn(Z q)-> eq(not(or(p)(q)))(and(not(p))(not(q)));

//ejercicio 2//
Z => Z succ := fn(Z z) -> sub(-1)(z);