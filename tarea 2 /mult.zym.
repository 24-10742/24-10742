Z => Z abs := fn(Z n) -> if(n < 0, 0 - n, n);
Z => Z => Z mult := fn(Z y) -> fn(Z x) -> if(abs(x) < abs(y),mult(x)(y), if(y = 0,0,if(y < 0,(0 - x) + mult(y + 1)(x),x + mult(y - 1)(x))));
